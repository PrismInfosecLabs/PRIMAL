FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libssl-dev \
    libffi-dev \
    python3-dev \
    build-essential \
    libmagic1 \
    curl \
    git \
    autoconf \
    libtool \
    libjansson-dev \
    libssl-dev \
    libmagic-dev \
    pkg-config \
    bison \
    flex \
    && rm -rf /var/lib/apt/lists/*

# Build YARA from source with math module
RUN git clone --recursive https://github.com/VirusTotal/yara.git /tmp/yara && \
    cd /tmp/yara && \
    ./bootstrap.sh && \
    ./configure --enable-magic --enable-cuckoo --with-crypto && \
    make && \
    make install && \
    ldconfig && \
    cd / && \
    rm -rf /tmp/yara

# Create user with UID 1000 to match host user (fixes permission issues)
RUN groupadd -g 1000 appuser && useradd -u 1000 -g 1000 -s /bin/bash -m appuser

# Set working directory
WORKDIR /app

# Copy requirements first (for better caching)
COPY requirements.orchestrator.txt .
RUN pip install --no-cache-dir -r requirements.orchestrator.txt

# Copy application files
COPY app.py .
COPY config/ config/
COPY services/ services/
COPY api/ api/
COPY models/ models/
COPY utils/ utils/
COPY static/ static/
COPY av_services/ av_services/

# Create internal directories and set ownership
RUN mkdir -p uploads reports rules data logs shared-files && \
    chown -R appuser:appuser /app 

# Copy simplified entrypoint that doesn't try to fix permissions
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Switch to user with matching UID
USER 1000:1000

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "app.py"]