# PRIMAL v2.0 Environment Configuration
# Copy this file to .env and update with your values

# SECURITY - CHANGE THESE IN PRODUCTION
SECRET_KEY=your-super-secret-key-change-this-in-production-use-64-chars-minimum
FLASK_ENV=production

# API Keys (Optional - for remote engines)
# Get these from the respective services
VIRUSTOTAL_API_KEY=
HYBRID_ANALYSIS_API_KEY=
METADEFENDER_API_KEY=

# Container URLs (Auto-configured - don't change unless needed)
CLAMAV_URL=http://clamav-scanner:5000

# Security Settings
UPLOAD_MAX_SIZE=104857600  # 100MB in bytes
SCAN_TIMEOUT=300           # 5 minutes max scan time
MAX_CONCURRENT_SCANS=5     # Limit concurrent operations

# Database Security
DATABASE_ENCRYPTION_KEY=change-this-to-a-32-byte-key-for-db-encryption

# Network Security
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8080

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_ROTATION_SIZE=10MB
LOG_RETENTION_DAYS=30

# Python Settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONHASHSEED=random
